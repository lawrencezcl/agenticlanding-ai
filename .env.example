# NextAuth.js Configuration
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-nextauth-secret-here

# OAuth Providers
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GITHUB_ID=your-github-client-id
GITHUB_SECRET=your-github-client-secret

# Email Provider (Optional)
EMAIL_SERVER_HOST=smtp.gmail.com
EMAIL_SERVER_PORT=587
EMAIL_SERVER_USER=your-email@gmail.com
EMAIL_SERVER_PASSWORD=your-app-password
EMAIL_FROM=noreply@yourdomain.com

# Database Configuration
DATABASE_URL=postgresql://username:password@localhost:5432/agenticlanding
POSTGRES_PRISMA_URL=postgresql://username:password@localhost:5432/agenticlanding
POSTGRES_URL_NON_POOLING=postgresql://username:password@localhost:5432/agenticlanding
POSTGRES_USER=username
POSTGRES_HOST=localhost
POSTGRES_PASSWORD=password
POSTGRES_DATABASE=agenticlanding

# Vercel KV Configuration
KV_REST_API_URL=your-kv-rest-api-url
KV_REST_API_TOKEN=your-kv-rest-api-token

# Vercel Blob Configuration
BLOB_READ_WRITE_TOKEN=your-blob-read-write-token

# LLM Provider API Keys
OPENAI_API_KEY=your-openai-api-key
GOOGLE_AI_API_KEY=your-google-ai-api-key
DEEPSEEK_API_KEY=your-deepseek-api-key
QWEN_API_KEY=your-qwen-api-key

# Optional: Deployment Webhook
DEPLOYMENT_WEBHOOK_URL=your-deployment-webhook-url

# Analytics (Optional)
GA_TRACKING_ID=your-ga-tracking-id
GTM_ID=your-gtm-id

# CRM Integration (Optional)
SALESFORCE_API_KEY=your-salesforce-api-key
HUBSPOT_API_KEY=your-hubspot-api-key